@model Web.Core.DTOs.NoReadKasanaReadKomalReportResult
@{
    ViewData["Title"] = "No Read at Kasana Side and Read at Komal Side";
    var selectedDate = Model.SelectedDate == default ? DateTime.Today : Model.SelectedDate;
    var currentPage = int.TryParse(ViewContext.HttpContext.Request.Query["page"], out var pageValue) && pageValue > 0 ? pageValue : 1;
    var pageSize = 50;
    var totalRows = Model.Details.Count;
    var pageCount = Math.Max(1, (int)Math.Ceiling(totalRows / (double)pageSize));
    currentPage = Math.Min(currentPage, pageCount);
    var items = Model.Details.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">No Read at Kasana Side and Read at Komal Side</h1>
                <p class="mt-1 text-sm text-gray-500">Barcodes scanned at Komal side but not scanned at Kasana side in the same shift window.</p>
            </div>
        </div>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
            <span class="text-red-700 font-medium">@ViewBag.Error</span>
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        <div class="bg-white rounded-xl shadow-card border border-blue-100 p-5">
            <div class="text-xs font-bold uppercase tracking-wider text-blue-600">Kasana Read</div>
            <div class="mt-2 text-3xl font-bold text-gray-900">@Model.TotalKasanaRead.ToString("N0")</div>
        </div>
        <div class="bg-white rounded-xl shadow-card border border-green-100 p-5">
            <div class="text-xs font-bold uppercase tracking-wider text-green-600">Komal Read</div>
            <div class="mt-2 text-3xl font-bold text-gray-900">@Model.TotalKomalRead.ToString("N0")</div>
        </div>
        <div class="bg-white rounded-xl shadow-card border border-rose-100 p-5">
            <div class="text-xs font-bold uppercase tracking-wider text-rose-600">No Read At Kasana</div>
            <div class="mt-2 text-3xl font-bold text-gray-900">@Model.TotalNoReadAtKasanaReadAtKomal.ToString("N0")</div>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-card border border-neutral-200 p-4 mb-6">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
            <div>
                <h2 class="text-lg font-semibold text-gray-900">Report Filter</h2>
                <p class="text-sm text-gray-500">Select date and export report from here.</p>
            </div>
            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
                <form method="get" class="flex flex-col sm:flex-row items-start sm:items-center gap-2">
                    <input type="date" name="date" value="@selectedDate.ToString("yyyy-MM-dd")"
                           class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
                    <button type="submit"
                            class="px-4 py-2 bg-brand-600 text-white text-sm font-medium rounded-lg hover:bg-brand-700 transition-colors">
                        Search
                    </button>
                </form>
                <a href="@Url.Action("ExportNoReadKasanaReadKomalExcel", "Reports", new { date = selectedDate })"
                   class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-green-600 border border-green-700 rounded-lg hover:bg-green-700 transition-colors">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    Export Excel
                </a>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-card overflow-hidden mb-8">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">Barcode Details</h2>
            <p class="text-sm text-gray-500">Only those barcodes are shown that were read at Komal side and not read at Kasana side.</p>
        </div>

        @if (items.Any())
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">S/N</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Barcode</th>
                            <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Kasana Side</th>
                            <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Komal Side</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Sorter Scan Time</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Last Sorter Scan Time</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @for (var i = 0; i < items.Count; i++)
                        {
                            var item = items[i];
                            var serialNo = ((currentPage - 1) * pageSize) + i + 1;
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-700">@serialNo</td>
                                <td class="px-4 py-3 whitespace-nowrap text-sm font-mono text-gray-900">@item.Barcode</td>
                                <td class="px-4 py-3 whitespace-nowrap text-center">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-red-100 text-red-700 text-xs font-semibold">
                                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                        </svg>
                                        @item.KasanaStatus
                                    </span>
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap text-center">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-green-100 text-green-700 text-xs font-semibold">
                                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                        </svg>
                                        @item.KomalStatus
                                    </span>
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-700">
                                    @(item.FirstKomalScanTime?.ToString("dd-MMM-yyyy hh:mm:ss tt") ?? "-")
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-700">
                                    @(item.LastKomalScanTime?.ToString("dd-MMM-yyyy hh:mm:ss tt") ?? "-")
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="bg-gray-100 font-semibold">
                        <tr>
                            <td colspan="4" class="px-4 py-3 text-sm text-right text-gray-900">TOTAL</td>
                            <td colspan="2" class="px-4 py-3 text-sm text-gray-900">@totalRows.ToString("N0") rows</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="px-6 py-4 border-t border-gray-200 bg-gray-50 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                <div class="text-sm text-gray-600">
                    Showing @((currentPage - 1) * pageSize + 1) to @(Math.Min(currentPage * pageSize, totalRows)) of @totalRows rows
                </div>
                <div class="flex items-center gap-2">
                    <a href="@Url.Action("NoReadKasanaReadKomal", "Reports", new { date = selectedDate, page = Math.Max(1, currentPage - 1) })"
                       class="px-3 py-2 text-sm font-medium rounded-lg border border-gray-300 @(currentPage == 1 ? "pointer-events-none opacity-50 bg-gray-100 text-gray-400" : "bg-white text-gray-700 hover:bg-gray-100")">
                        Previous
                    </a>
                    <span class="text-sm text-gray-600">Page @currentPage of @pageCount</span>
                    <a href="@Url.Action("NoReadKasanaReadKomal", "Reports", new { date = selectedDate, page = Math.Min(pageCount, currentPage + 1) })"
                       class="px-3 py-2 text-sm font-medium rounded-lg border border-gray-300 @(currentPage == pageCount ? "pointer-events-none opacity-50 bg-gray-100 text-gray-400" : "bg-white text-gray-700 hover:bg-gray-100")">
                        Next
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="p-8 text-center">
                <h3 class="text-lg font-medium text-gray-900 mb-1">No Data Found</h3>
                <p class="text-gray-500">No barcodes found where Kasana side was not read and Komal side was read for the selected shift window.</p>
            </div>
        }
    </div>
</div>
