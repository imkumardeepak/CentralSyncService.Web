@model Web.Core.DTOs.VarianceTransferReportResult
@{
    ViewData["Title"] = "Variance Transfer Report";
    var selectedDate = Model.SelectedDate == default ? DateTime.Today : Model.SelectedDate;
    var selectedStatus = (Context.Request.Query["status"].ToString() ?? "ALL").Trim().ToUpperInvariant();
    if (string.IsNullOrWhiteSpace(selectedStatus) || selectedStatus == "EXTRA_TRANSFER")
    {
        selectedStatus = "ALL";
    }

    var filteredProduced = selectedStatus switch
    {
        "CORRECT" => Model.ProducedDetails.Where(x => x.IsMatched).ToList(),
        "UNMATCHED" => Model.ProducedDetails.Where(x => !x.IsMatched).ToList(),
        _ => Model.ProducedDetails
    };

    var producedPage = int.TryParse(Context.Request.Query["producedPage"], out var producedPageValue) && producedPageValue > 0
        ? producedPageValue
        : 1;
    var pageSize = 50;
    var producedTotal = filteredProduced.Count;
    var producedPageCount = Math.Max(1, (int)Math.Ceiling(producedTotal / (double)pageSize));
    producedPage = Math.Min(producedPage, producedPageCount);
    var producedItems = filteredProduced.Skip((producedPage - 1) * pageSize).Take(pageSize).ToList();
    var displayVariance = Model.TotalTransfer - Model.TotalProduction;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Variance Transfer Report</h1>
                <p class="mt-1 text-sm text-gray-500">Production vs Sorter transfer barcode matching (Shift: 07:00 - 06:59)</p>
            </div>
        </div>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
            <span class="text-red-700 font-medium">@ViewBag.Error</span>
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 mb-8">
        <div class="bg-white rounded-xl shadow-card border border-blue-100 p-5">
            <div class="text-xs font-bold uppercase tracking-wider text-blue-600">Total Production</div>
            <div class="mt-2 text-3xl font-bold text-gray-900">@Model.TotalProduction.ToString("N0")</div>
        </div>
        <div class="bg-white rounded-xl shadow-card border border-green-100 p-5">
            <div class="text-xs font-bold uppercase tracking-wider text-green-600">Total Transfer</div>
            <div class="mt-2 text-3xl font-bold text-gray-900">@Model.TotalTransfer.ToString("N0")</div>
        </div>
        <div class="bg-white rounded-xl shadow-card border border-amber-100 p-5">
            <div class="text-xs font-bold uppercase tracking-wider text-amber-600">Variance</div>
            <div class="mt-2 text-3xl font-bold @(displayVariance < 0 ? "text-red-700" : "text-green-700")">
                @(displayVariance >= 0 ? $"+{displayVariance:N0}" : displayVariance.ToString("N0"))
            </div>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-card border border-neutral-200 p-4 mb-6">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
            <div>
                <h2 class="text-lg font-semibold text-gray-900">Report Filter</h2>
                <p class="text-sm text-gray-500">Change date and export full report from here.</p>
            </div>
            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
                <form method="get" class="flex flex-col sm:flex-row items-start sm:items-center gap-2">
                    <input type="date" name="date" value="@selectedDate.ToString("yyyy-MM-dd")"
                           class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
                    <select name="status"
                            class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
                        <option value="ALL" selected="@(selectedStatus == "ALL")">All Status</option>
                        <option value="CORRECT" selected="@(selectedStatus == "CORRECT")">Correct</option>
                        <option value="UNMATCHED" selected="@(selectedStatus == "UNMATCHED")">Unmatched</option>
                    </select>
                    <button type="submit"
                            class="px-4 py-2 bg-brand-600 text-white text-sm font-medium rounded-lg hover:bg-brand-700 transition-colors">
                        Search
                    </button>
                </form>
                <a href="@Url.Action("ExportVarianceTransferReportExcel", "Reports", new { date = selectedDate, status = selectedStatus })"
                   class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-green-600 border border-green-700 rounded-lg hover:bg-green-700 transition-colors">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    Export Excel
                </a>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-card overflow-hidden mb-8">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">Produced Barcode Details</h2>
            <p class="text-sm text-gray-500">Each produced barcode checked against TO transfer scans.</p>
        </div>

        @if (filteredProduced.Any())
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">S/N</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Barcode</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">SAP Code</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Batch</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Order No</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Production Time</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Sorter Scan Time</th>
                            <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @for (var i = 0; i < producedItems.Count; i++)
                        {
                            var item = producedItems[i];
                            var serialNo = ((producedPage - 1) * pageSize) + i + 1;
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-700">@serialNo</td>
                                <td class="px-4 py-3 whitespace-nowrap text-sm font-mono text-gray-900">@item.Barcode</td>
                                <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-700">@item.SapCode</td>
                                <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-700">@item.BatchNo</td>
                                <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-700">@item.OrderNo</td>
                                <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-700">
                                    @(item.ProductionTime?.ToString("dd-MMM-yyyy hh:mm:ss tt") ?? "-")
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-700">
                                    @(item.FirstTransferTime?.ToString("dd-MMM-yyyy hh:mm:ss tt") ?? "-")
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap text-center">
                                    @if (item.IsMatched)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-green-100 text-green-700 text-xs font-semibold">
                                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                            </svg>
                                            Correct
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-red-100 text-red-700 text-xs font-semibold">
                                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                            </svg>
                                            Unmatched
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="bg-gray-100 font-semibold">
                        <tr>
                            <td colspan="5" class="px-4 py-3 text-sm text-right text-gray-900">TOTAL</td>
                            <td colspan="3" class="px-4 py-3 text-sm text-gray-900">@producedTotal.ToString("N0") rows</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="px-6 py-4 border-t border-gray-200 bg-gray-50 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                <div class="text-sm text-gray-600">
                    Showing @((producedPage - 1) * pageSize + 1) to @(Math.Min(producedPage * pageSize, producedTotal)) of @producedTotal produced rows
                </div>
                <div class="flex items-center gap-2">
                    <a href="@Url.Action("VarianceTransferReport", "Reports", new { date = selectedDate, status = selectedStatus, producedPage = Math.Max(1, producedPage - 1) })"
                       class="px-3 py-2 text-sm font-medium rounded-lg border border-gray-300 @(producedPage == 1 ? "pointer-events-none opacity-50 bg-gray-100 text-gray-400" : "bg-white text-gray-700 hover:bg-gray-100")">
                        Previous
                    </a>
                    <span class="text-sm text-gray-600">Page @producedPage of @producedPageCount</span>
                    <a href="@Url.Action("VarianceTransferReport", "Reports", new { date = selectedDate, status = selectedStatus, producedPage = Math.Min(producedPageCount, producedPage + 1) })"
                       class="px-3 py-2 text-sm font-medium rounded-lg border border-gray-300 @(producedPage == producedPageCount ? "pointer-events-none opacity-50 bg-gray-100 text-gray-400" : "bg-white text-gray-700 hover:bg-gray-100")">
                        Next
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="p-8 text-center">
                <h3 class="text-lg font-medium text-gray-900 mb-1">No Production Data</h3>
                <p class="text-gray-500">No produced rows found for selected status filter.</p>
            </div>
        }
    </div>
</div>
