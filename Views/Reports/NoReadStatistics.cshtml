@model List<Web.Core.DTOs.NoReadStatisticsRecord>
@{
    ViewData["Title"] = "No Read Statistics Report";
    var selectedDate = ViewBag.Date as DateTime? ?? DateTime.Today;
    var showKasanaTop = ViewBag.ShowKasanaTop as bool? ?? true;
    var showKasanaBelow = ViewBag.ShowKasanaBelow as bool? ?? true;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">No Read Statistics Report</h1>
                <p class="mt-1 text-sm text-gray-500">Hourly No Read breakdown for Kasana (FROM) side</p>
            </div>
            <div class="flex items-center gap-3">
                <a href="@Url.Action("ExportNoReadStatisticsExcel", "Reports", new { date = selectedDate })"
                       class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-green-600 border border-green-700 rounded-lg hover:bg-green-700">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    Export Excel
                </a>
                <form method="get" class="flex items-center gap-3 flex-wrap">
                    <input type="date" name="date" value="@selectedDate.ToString("yyyy-MM-dd")"
                           class="px-3 py-2 border border-gray-300 rounded-lg text-sm" />
                    <label class="inline-flex items-center gap-1.5 text-sm text-gray-700 cursor-pointer">
                        <input type="checkbox" name="showKasanaTop" value="true" @(showKasanaTop ? "checked" : "")
                               class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500" />
                        <span>Kasana 1st Floor</span>
                    </label>
                    <label class="inline-flex items-center gap-1.5 text-sm text-gray-700 cursor-pointer">
                        <input type="checkbox" name="showKasanaBelow" value="true" @(showKasanaBelow ? "checked" : "")
                               class="w-4 h-4 text-green-600 border-gray-300 rounded focus:ring-green-500" />
                        <span>Kasana Grnd Floor</span>
                    </label>
                    <button type="submit"
                            class="px-4 py-2 bg-brand-600 text-white text-sm font-medium rounded-lg hover:bg-brand-700">
                        Search
                    </button>
                </form>
            </div>
        </div>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
            <span class="text-red-700 font-medium">@ViewBag.Error</span>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="bg-white rounded-xl shadow overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-lg font-semibold text-gray-900">Shift Day: @selectedDate.ToString("dd-MMM-yyyy") (07:00 -
                    06:59)</h2>
                </div>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th rowspan="2" class="px-4 py-3 text-left text-xs font-bold text-gray-700 uppercase">Hour</th>
                                @if (showKasanaTop)
                                {
                                    <th colspan="3" class="px-2 py-2 text-center text-xs font-bold text-blue-700 bg-blue-50">Kasana
                                        1st Floor</th>
                                    }
                                    @if (showKasanaBelow)
                                    {
                                        <th colspan="3" class="px-2 py-2 text-center text-xs font-bold text-green-700 bg-green-50">
                                            Kasana Grnd Floor</th>
                                        }
                                    </tr>
                                    <tr>
                                        @if (showKasanaTop)
                                        {
                                            <th class="px-2 py-2 text-center text-xs font-medium text-gray-500">Total</th>
                                            <th class="px-2 py-2 text-center text-xs font-medium text-red-600">No Read</th>
                                            <th
                                                class="px-2 py-2 text-center text-xs font-medium text-gray-500 @(showKasanaBelow ? "border-r" : "")">
                                                %</th>
                                            }
                                            @if (showKasanaBelow)
                                            {
                                                <th class="px-2 py-2 text-center text-xs font-medium text-gray-500">Total</th>
                                                <th class="px-2 py-2 text-center text-xs font-medium text-red-600">No Read</th>
                                                <th class="px-2 py-2 text-center text-xs font-medium text-gray-500">%</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-200">
                                        @foreach (var item in Model)
                                        {
                                            <tr class="hover:bg-gray-50">
                                                <td class="px-4 py-3 text-sm font-medium text-gray-900">@item.HourLabel</td>
                                                @if (showKasanaTop)
                                                {
                                                    <td class="px-2 py-3 text-center text-sm text-gray-900">@item.KasanaTopTotal.ToString("N0")</td>
                                                    <td
                                                        class="px-2 py-3 text-center text-sm font-bold @(item.KasanaTopNoRead > 0 ? "text-red-600" : "text-gray-500")">
                                                        @item.KasanaTopNoRead.ToString("N0")</td>
                                                        <td
                                                            class="px-2 py-3 text-center text-sm font-bold @(showKasanaBelow ? "border-r" : "")
                                                            @(item.KasanaTopPct > 20 ? "text-red-600" : item.KasanaTopPct > 10 ? "text-amber-600" : "text-gray-600")">
                                                            @item.KasanaTopPct.ToString("N2")%
                                                        </td>
                                                    }
                                                    @if (showKasanaBelow)
                                                    {
                                                        <td class="px-2 py-3 text-center text-sm text-gray-900">@item.KasanaBelowTotal.ToString("N0")
                                                        </td>
                                                        <td
                                                            class="px-2 py-3 text-center text-sm font-bold @(item.KasanaBelowNoRead > 0 ? "text-red-600" : "text-gray-500")">
                                                            @item.KasanaBelowNoRead.ToString("N0")</td>
                                                            <td
                                                                class="px-2 py-3 text-center text-sm font-bold
                                                                @(item.KasanaBelowPct > 20 ? "text-red-600" : item.KasanaBelowPct > 10 ? "text-amber-600" : "text-gray-600")">
                                                                @item.KasanaBelowPct.ToString("N2")%
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot class="bg-gray-100 font-bold">
                                                <tr>
                                                    <td class="px-4 py-3 text-sm">TOTAL</td>
                                                    @if (showKasanaTop)
                                                    {
                                                        <td class="px-2 py-3 text-center text-sm">@Model.Sum(x => x.KasanaTopTotal).ToString("N0")</td>
                                                        <td class="px-2 py-3 text-center text-sm text-red-700">@Model.Sum(x =>
                                                                                        x.KasanaTopNoRead).ToString("N0")</td>
                                                            <td class="px-2 py-3 text-center text-sm @(showKasanaBelow ? "border-r" : "")">
                                                                @{
                                                                    var topTotal = Model.Sum(x => x.KasanaTopTotal);
                                                                    var topNoRead = Model.Sum(x => x.KasanaTopNoRead);
                                                                    var topPct = topTotal > 0 ? (decimal)topNoRead * 100 / topTotal : 0;
                                                                }
                                                                @topPct.ToString("N2")%
                                                            </td>
                                                        }
                                                        @if (showKasanaBelow)
                                                        {
                                                            <td class="px-2 py-3 text-center text-sm">@Model.Sum(x => x.KasanaBelowTotal).ToString("N0")
                                                            </td>
                                                            <td class="px-2 py-3 text-center text-sm text-red-700">@Model.Sum(x =>
                                                                                            x.KasanaBelowNoRead).ToString("N0")</td>
                                                                <td class="px-2 py-3 text-center text-sm">
                                                                    @{
                                                                        var belowTotal = Model.Sum(x => x.KasanaBelowTotal);
                                                                        var belowNoRead = Model.Sum(x => x.KasanaBelowNoRead);
                                                                        var belowPct = belowTotal > 0 ? (decimal)belowNoRead * 100 / belowTotal : 0;
                                                                    }
                                                                    @belowPct.ToString("N2")%
                                                                </td>
                                                            }
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                            </div>
                                        </div>
                                    }
    else
                                    {
                                        <div class="p-8 text-center bg-white rounded-xl shadow">
                                            <h3 class="text-lg font-medium text-gray-900 mb-1">No Data Found</h3>
                                            <p class="text-gray-500">No scan records found for the selected shift day.</p>
                                        </div>
                                    }
                                </div>
